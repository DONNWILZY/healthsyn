DATABASE_URL="postgresql://postgres:postgres@localhost:5432/healthsync"

PORT="3000"
APP_NAME="HealthSync Pro"
NODE_ENV="development"

JWT_ISSUER="health-syn"
JWT_AUDIENCE="health-syn-clients"
ACCESS_TOKEN_TTL_MINUTES="15"
REFRESH_TOKEN_TTL_DAYS="30"

THROTTLE_TTL_MS="60000"
THROTTLE_LIMIT="100"

EMAIL_ENABLED="false"
EMAIL_PROVIDER="SMTP"
EMAIL_FROM_NAME="HealthSync Pro"
EMAIL_FROM_ADDRESS="noreply@healthsync.com"
EMAIL_REPLY_TO="support@healthsync.com"
EMAIL_HOST="smtp.example.com"
EMAIL_PORT="587"
EMAIL_SECURE="false"
EMAIL_USER=""
EMAIL_PASSWORD=""
# EMAIL_TEMPLATES_DIR="/absolute/path/to/custom/templates"

# Legacy SMTP names still supported by config. Set one naming convention.
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_USERNAME=""
# SMTP_PASSWORD=""
# SMTP_FROM_EMAIL="noreply@healthsync.com"
# SMTP_FROM_NAME="HealthSync Pro"

REDIS_URL="redis://localhost:6379"
ENCRYPTION_KEY="replace-with-a-real-key"

STORAGE_BUCKET="healthsync-uploads"
STORAGE_REGION="us-east-1"
STORAGE_ENDPOINT=""
