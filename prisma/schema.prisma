}

model ComplianceIncident {
  id           String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  incidentType IncidentType     @map("incident_type")
  severity     IncidentSeverity
  status       IncidentStatus   @default(OPEN)

  title       String @db.VarChar(255)
  description String @db.Text

  reportedBy String  @map("reported_by") @db.Uuid
  assignedTo String? @map("assigned_to") @db.Uuid

  affectedPatients String[] @default([]) @map("affected_patients")
  affectedSystems  String[] @default([]) @map("affected_systems")

  occurredAt DateTime  @map("occurred_at")
  detectedAt DateTime  @default(now()) @map("detected_at")
  resolvedAt DateTime? @map("resolved_at")

  remediationSteps Json? @map("remediation_steps")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  reporter User  @relation("IncidentReporter", fields: [reportedBy], references: [id])
  assignee User? @relation("IncidentAssigned", fields: [assignedTo], references: [id])

  @@index([severity, status])
  @@index([reportedBy])
  @@index([occurredAt])
  @@map("compliance_incidents")
}

// ============================================================================
// NOTIFICATIONS & MESSAGING
// ============================================================================

model Notification {
  id       String               @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId   String               @map("user_id") @db.Uuid
  type     NotificationType
  priority NotificationPriority @default(NORMAL)

  title   String @db.VarChar(255)
  message String @db.Text

  read   Boolean   @default(false)
  readAt DateTime? @map("read_at")

  actionUrl  String? @map("action_url")
  actionData Json?   @map("action_data")

  sentAt    DateTime  @default(now()) @map("sent_at")
  expiresAt DateTime? @map("expires_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read, sentAt(sort: Desc)])
  @@index([userId, type, read])
  @@map("notifications")
}

model Message {
  id          String      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  senderId    String      @map("sender_id") @db.Uuid
  recipientId String      @map("recipient_id") @db.Uuid
  messageType MessageType @map("message_type")

  subject String? @db.VarChar(255)
  body    String  @db.Text

  attachments Json?

  read   Boolean   @default(false)
  readAt DateTime? @map("read_at")

  repliedTo String? @map("replied_to") @db.Uuid

  sentAt DateTime @default(now()) @map("sent_at")

  sender    User @relation("SentMessages", fields: [senderId], references: [id])
  recipient User @relation("ReceivedMessages", fields: [recipientId], references: [id])

  @@index([recipientId, read, sentAt(sort: Desc)])
  @@index([senderId, sentAt(sort: Desc)])
  @@map("messages")
}

// ============================================================================
// SYSTEM CONFIGURATION
// ============================================================================

model SystemSetting {
  id             String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  key            String   @db.VarChar(100)
  value          Json
  description    String?  @db.Text
  isEncrypted    Boolean  @default(false) @map("is_encrypted")
  updatedBy      String   @map("updated_by") @db.Uuid
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization? @relation(fields: [organizationId], references: [id])
  updater      User          @relation(fields: [updatedBy], references: [id])

  @@unique([organizationId, key])
  @@map("system_settings")
}

model ExternalSystem {
  id                 String             @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  organizationId     String             @map("organization_id") @db.Uuid
  systemType         ExternalSystemType @map("system_type")
  name               String             @db.VarChar(255)
  endpoint           String
  authenticationType AuthenticationType @map("authentication_type")

  credentials Json?

  active     Boolean   @default(true)
  lastSyncAt DateTime? @map("last_sync_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization  @relation(fields: [organizationId], references: [id])
  syncLogs     DataSyncLog[]

  @@index([organizationId, systemType])
  @@map("external_systems")
}

model DataSyncLog {
  id               String     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  externalSystemId String     @map("external_system_id") @db.Uuid
  syncType         SyncType   @map("sync_type")
  status           SyncStatus

  recordsProcessed Int @default(0) @map("records_processed")
  recordsFailed    Int @default(0) @map("records_failed")

  errorMessage String? @map("error_message") @db.Text

  startedAt   DateTime  @map("started_at")
  completedAt DateTime? @map("completed_at")

  externalSystem ExternalSystem @relation(fields: [externalSystemId], references: [id])

  @@index([externalSystemId, startedAt(sort: Desc)])
  @@map("data_sync_logs")
}

model WebhookSubscription {
  id             String  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  eventType      String  @map("event_type") @db.VarChar(100)
  url            String
  secret         String  @db.VarChar(255)
  active         Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")

  organization Organization      @relation(fields: [organizationId], references: [id])
  deliveries   WebhookDelivery[]

  @@index([organizationId, eventType, active])
  @@map("webhook_subscriptions")
}

model WebhookDelivery {
  id             String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  subscriptionId String @map("subscription_id") @db.Uuid
  eventType      String @map("event_type") @db.VarChar(100)
  payload        Json

  status     String  @default("PENDING") @db.VarChar(20)
  httpStatus Int?    @map("http_status")
  response   String? @db.Text

  attempts  Int       @default(0)
  nextRetry DateTime? @map("next_retry")

  deliveredAt DateTime? @map("delivered_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  subscription WebhookSubscription @relation(fields: [subscriptionId], references: [id])

  @@index([subscriptionId, createdAt(sort: Desc)])
  @@index([status, nextRetry])
  @@map("webhook_deliveries")
}

model DataExportRequest {
  id         String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId     String @map("user_id") @db.Uuid
  exportType String @map("export_type") @db.VarChar(50)
  format     String @db.VarChar(20)

  dateRange Json? @map("date_range")
  filters   Json?

  status String @default("PENDING") @db.VarChar(20)

  fileUrl   String?   @map("file_url")
  fileSize  Int?      @map("file_size")
  expiresAt DateTime? @map("expires_at")

  requestedAt DateTime  @default(now()) @map("requested_at")
  completedAt DateTime? @map("completed_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId, requestedAt(sort: Desc)])
  @@map("data_export_requests")
}

// ============================================================================
// PROVIDER ORGANIZATION RELATIONSHIP
// ============================================================================

model ProviderOrganization {
  id             String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  providerId     String @map("provider_id") @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  isPrimaryAffiliation Boolean @default(false) @map("is_primary_affiliation")
  department           String? @db.VarChar(100)

  startDate DateTime  @map("start_date") @db.Date
  endDate   DateTime? @map("end_date") @db.Date

  credentialedAt    DateTime? @map("credentialed_at")
  privilegesGranted Json?     @map("privileges_granted")

  active Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  provider     HealthcareProvider @relation(fields: [providerId], references: [id])
  organization Organization       @relation(fields: [organizationId], references: [id])

  @@unique([providerId, organizationId])
  @@index([organizationId, active])
  @@map("provider_organizations")
}

model Pharmacy {
  id             String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  licenseNumber String  @unique @map("license_number") @db.VarChar(100)
  deaNumber     String? @map("dea_number") @db.VarChar(20)

  operatingHours Json?  @map("operating_hours")
  services       Json[] @default([])

  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@map("pharmacies")
}
