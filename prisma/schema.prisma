// ============================================================================

model Transaction {
  id             String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  paymentId      String @unique @map("payment_id") @db.Uuid

  transactionType String  @map("transaction_type") @db.VarChar(20) // CREDIT, DEBIT, REFUND
  amount          Decimal @db.Decimal(10, 2)
  currency        String  @default("USD") @db.VarChar(3)

  // Balance tracking
  balanceBefore Decimal @map("balance_before") @db.Decimal(10, 2)
  balanceAfter  Decimal @map("balance_after") @db.Decimal(10, 2)

  // Transaction details
  description String  @db.VarChar(255)
  category    String? @db.VarChar(50) // CONSULTATION, MEDICATION, LAB_TEST, etc.

  // Reference
  referenceType String? @map("reference_type") @db.VarChar(50) // INVOICE, CLAIM, REFUND
  referenceId   String? @map("reference_id") @db.Uuid

  // Settlement
  settledAt DateTime? @map("settled_at")
  settled   Boolean   @default(false)

  // Metadata
  metadata Json?

  createdAt DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  payment      Payment      @relation(fields: [paymentId], references: [id])

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, settled, createdAt(sort: Desc)])
  @@index([transactionType, createdAt(sort: Desc)])
  @@map("transactions")
}

