// ============================================================================
// CORE IDENTITY MODELS
// ============================================================================

model User {
  id          String      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  accountType AccountType @map("account_type")

  firstName   String   @map("first_name") @db.VarChar(100)
  middleName  String?  @map("middle_name") @db.VarChar(100)
  lastName    String   @map("last_name") @db.VarChar(100)
  dateOfBirth DateTime @map("date_of_birth") @db.Date
  gender      String?  @db.VarChar(20)

  // Banking-grade encryption
  emailEncrypted Bytes  @unique @map("email_encrypted")
  emailHash      String @unique @map("email_hash") @db.VarChar(64)
  phoneEncrypted Bytes  @map("phone_encrypted")
  phoneHash      String @map("phone_hash") @db.VarChar(64)
  address        Json?

  // Password security (Argon2id recommended)
  passwordHash        String    @map("password_hash") @db.VarChar(255)
  passwordSalt        String    @map("password_salt") @db.VarChar(255)
  passwordChangedAt   DateTime? @map("password_changed_at")
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until")

  // Two-factor authentication
  twoFactorEnabled         Boolean @default(false) @map("two_factor_enabled")
  twoFactorSecretEncrypted Bytes?  @map("two_factor_secret_encrypted")
  backupCodesEncrypted     Bytes?  @map("backup_codes_encrypted")

  // Session management
  lastLogin    DateTime? @map("last_login")
  lastActivity DateTime? @map("last_activity")
  sessionToken String?   @unique @map("session_token") @db.VarChar(255)

  // Account status
  status        AccountStatus @default(PENDING_VERIFICATION)
  emailVerified Boolean       @default(false) @map("email_verified")
  phoneVerified Boolean       @default(false) @map("phone_verified")

  profilePictureUrl String? @map("profile_picture_url")

  // Metadata & timezone
  timezone String? @default("UTC") @db.VarChar(50)
  locale   String? @default("en-US") @db.VarChar(10)
  metadata Json?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // Relations
  patients                    Patient[]
  healthcareProvider          HealthcareProvider?
  organizationStaff           OrganizationStaff[]
  managedByCaregivers         Caregiver[]          @relation("ManagedUser")
  caregiverFor                Caregiver[]          @relation("CaregiverUser")
  otps                        Otp[]
  accessTokens                AccessToken[]
  userRoles                   UserRole[]
  notifications               Notification[]
  sentMessages                Message[]            @relation("SentMessages")
  receivedMessages            Message[]            @relation("ReceivedMessages")
  accessLogs                  AccessLog[]
  auditLogs                   AuditLog[]
  dataExportRequests          DataExportRequest[]
  complianceIncidentsReporter ComplianceIncident[] @relation("IncidentReporter")
  complianceIncidentsAssigned ComplianceIncident[] @relation("IncidentAssigned")
  systemSettingsUpdates       SystemSetting[]
  // digitalSignatures     DigitalSignature[]

  digitalSignatures DigitalSignature[] @relation("DigitalSignatureSignerUser")

  // @@unique([staffId, roleId])
  // @@map("staff_assignments")
}

model ShiftSchedule {
  id             String  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  staffId        String? @map("staff_id") @db.Uuid
  providerId     String? @map("provider_id") @db.Uuid

  shiftName String   @map("shift_name") @db.VarChar(100)
  date      DateTime @db.Date
  startTime String   @db.VarChar(5)
  endTime   String   @db.VarChar(5)

  department String? @db.VarChar(100)
  role       String? @db.VarChar(50)

  status ShiftStatus @default(SCHEDULED)

  actualStartTime DateTime? @map("actual_start_time")
  actualEndTime   DateTime? @map("actual_end_time")

  notes String?

  createdAt DateTime @default(now()) @map("created_at")

  organization Organization        @relation(fields: [organizationId], references: [id])
  staff        OrganizationStaff?  @relation(fields: [staffId], references: [id])
  provider     HealthcareProvider? @relation(fields: [providerId], references: [id])
  clockIns     StaffClockIn[]

  @@index([organizationId, date])
  @@index([staffId, date])
  @@index([providerId, date])
  @@index([status])
  @@map("shift_schedules")
}

model StaffActivity {
  id           String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  staffId      String @map("staff_id") @db.Uuid
  activityType String @map("activity_type") @db.VarChar(50)

  action       String
  resourceType String? @map("resource_type") @db.VarChar(50)
  resourceId   String? @map("resource_id") @db.Uuid

  timestamp DateTime @default(now())
  ipAddress String?  @db.Inet
  userAgent String?
  location  Json?

  changes  Json?
  metadata Json?

  staff OrganizationStaff @relation(fields: [staffId], references: [id])

  @@index([staffId, timestamp(sort: Desc)])
  @@index([resourceType, resourceId, timestamp])
  @@map("staff_activities")
}

// ============================================================================
// OTP SYSTEM
// ============================================================================

model Otp {
  id        String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  type      OtpType
  codeHash  String    @db.VarChar(64)
  expiresAt DateTime  @map("expires_at")
  used      Boolean   @default(false)
  usedAt    DateTime? @map("used_at")
  ipAddress String?   @map("ip_address") @db.Inet
  userAgent String?
  attempts  Int       @default(0)
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, createdAt(sort: Desc)])
  @@index([codeHash, used])
  @@map("otps")
}

// ============================================================================
// IMAGING STUDIES (DICOM)
// ============================================================================
model ImagingStudy {
  id                 String  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  patientId          String  @map("patient_id") @db.Uuid
  encounterId        String? @map("encounter_id") @db.Uuid
  organizationId     String  @map("organization_id") @db.Uuid
  orderingProviderId String? @map("ordering_provider_id") @db.Uuid

  modality         String  @db.VarChar(20)
  studyDescription String  @map("study_description") @db.VarChar(255)
  bodyPart         String? @map("body_part") @db.VarChar(100)

  studyDate       DateTime @map("study_date")
  accessionNumber String?  @unique @map("accession_number") @db.VarChar(50)

  studyInstanceUID String? @map("study_instance_uid") @db.VarChar(100)
  seriesCount      Int?    @map("series_count")
  instanceCount    Int?    @map("instance_count")

  findings   String? @db.Text
  impression String? @db.Text

  imagesUrl      String? @map("images_url")
  dicomServerUrl String? @map("dicom_server_url")

  status ImagingStatus @default(ORDERED)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  patient      Patient      @relation(fields: [patientId], references: [id])
  encounter    Encounter?   @relation(fields: [encounterId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([patientId, studyDate])
  @@index([encounterId])
  @@index([accessionNumber])
  @@map("imaging_studies")
}

model Patient {
  id          String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId      String @map("user_id") @db.Uuid
  patientCode String @unique @map("patient_code") @db.VarChar(20)

  // FHIR Identifier
  fhirId String? @unique @map("fhir_id") @db.VarChar(100)

  // Demographics
  bloodType String?  @map("blood_type") @db.VarChar(5)
  height    Decimal? @db.Decimal(5, 2)
  weight    Decimal? @db.Decimal(5, 2)

  emergencyContact Json? @map("emergency_contact")

  // PHI (Protected Health Information)
  ssnEncrypted                 Bytes? @map("ssn_encrypted")
  medicalRecordNumberEncrypted Bytes? @map("mrn_encrypted")

  // Status
  status      PatientStatus @default(ACTIVE)
  isDeceased  Boolean       @default(false) @map("is_deceased")
  dateOfDeath DateTime?     @map("date_of_death") @db.Date

  // Profile closure
  profileClosed Boolean   @default(false) @map("profile_closed")
  closedAt      DateTime? @map("closed_at")
  closedBy      String?   @map("closed_by") @db.Uuid
  closureReason String?   @map("closure_reason")

  // Legacy access
  legacyAccessEnabled Boolean @default(false) @map("legacy_access_enabled")

  registeredAt DateTime @default(now()) @map("registered_at")

  metadata  Json?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  caregivers      Caregiver[]      @relation("ManagedPatient")
  proxyActionLogs ProxyActionLog[]

  medicalRecords       MedicalRecord[]
  encounters           Encounter[]
  prescriptions        Prescription[]
  labResults           LabResult[]
  labOrders            LabOrder[]
  imagingStudies       ImagingStudy[]
  patientInsurance     PatientInsurance[]
  insuranceClaims      InsuranceClaim[]
  invoices             Invoice[]
  payments             Payment[]
  dataConsents         DataConsent[]
  appointments         Appointment[]
  vitalSigns           VitalSign[]
  allergies            Allergy[]
  medications          PatientMedication[]
  immunizations        Immunization[]
  familyHistory        FamilyHistory[]
  socialHistory        SocialHistory[]
  carePlans            CarePlan[]
  reminders            CareReminder[]
  reminderLogs         ReminderDeliveryLog[]
  deathCertificates    DeathCertificate[]
  legacyManagers       LegacyManager[]
  familyRelationships  FamilyRelationship[]  @relation("PersonRelationships")
  relatedFamilyMembers FamilyRelationship[]  @relation("RelatedPersonRelationships")
  geneticProfile       GeneticProfile?
  familyHealthHistory  FamilyHealthHistory[]
  fhirResources        FHIRResource[]
  patientAccessLogs    PatientAccessLog[]

  @@index([patientCode])
  @@index([userId])
  @@index([fhirId])
  @@index([status, deletedAt])
  @@index([isDeceased])
  @@map("patients")
}

model HealthcareProvider {
  id           String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId       String       @unique @map("user_id") @db.Uuid
  providerCode String       @unique @map("provider_code") @db.VarChar(20)
  providerType ProviderType @map("provider_type")

  // FHIR Identifier
  fhirId String? @unique @map("fhir_id") @db.VarChar(100)

  // Multiple specialties
  specialties ProviderSpecialty[] @default([])

  // Credentials
  licenseNumber String    @map("license_number") @db.VarChar(100)
  licenseState  String?   @map("license_state") @db.VarChar(2)
  licenseExpiry DateTime? @map("license_expiry") @db.Date
  npiNumber     String?   @unique @map("npi_number") @db.VarChar(20)
  deaNumber     String?   @map("dea_number") @db.VarChar(20)

  primarySpecialty     String? @map("primary_specialty") @db.VarChar(100)
  secondarySpecialties Json?   @map("secondary_specialties")
  boardCertifications  Json?   @map("board_certifications")

  medicalSchool     String? @map("medical_school") @db.VarChar(255)
  graduationYear    Int?    @map("graduation_year")
  yearsOfExperience Int?    @map("years_of_experience")

  languagesSpoken      Json?   @map("languages_spoken")
  acceptingNewPatients Boolean @default(true) @map("accepting_new_patients")

  // Emergency & location (PostGIS)
  isEmergencyAvailable Boolean   @default(false) @map("emergency_available")
  inEmergencyDirectory Boolean   @default(false) @map("in_emergency_directory")
  location             Json? // {lat, lng, address}
  geog                 Json?     @map("geog") // { "type": "Point", "coordinates": [-122.4194, 37.7749] }
  locationUpdatedAt    DateTime? @map("location_updated_at")

  // Digital signature for prescriptions
  digitalSignaturePublicKey           String? @map("digital_signature_public_key") @db.Text
  digitalSignaturePrivateKeyEncrypted Bytes?  @map("digital_signature_private_key_encrypted")

  status     ProviderStatus @default(ACTIVE)
  verifiedAt DateTime?      @map("verified_at")

  metadata  Json?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  user                     User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationAffiliations ProviderOrganization[]
  encounters               Encounter[]
  prescriptions            Prescription[]
  appointments             Appointment[]
  providerSchedule         ProviderSchedule[]
  shifts                   ShiftSchedule[]
  fhirResources            FHIRResource[]
  // digitalSignatures         DigitalSignature[]

  digitalSignatures DigitalSignature[] @relation("DigitalSignatureSignerProvider")

  @@index([providerCode])
  @@index([fhirId])
  @@index([npiNumber])
  @@index([providerType, status, deletedAt])
  @@index([userId])
  @@index([specialties])
  @@index([isEmergencyAvailable, inEmergencyDirectory])
  @@map("healthcare_providers")
}

model OrganizationStaff {
  id             String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId         String @map("user_id") @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  staffCode      String @map("staff_code") @db.VarChar(20)

  jobTitle   String  @map("job_title") @db.VarChar(100)
  department String? @db.VarChar(100)
  employeeId String? @unique @map("employee_id") @db.VarChar(50)

  // Work schedule & status
  workSchedule  Json?       @map("work_schedule")
  currentStatus StaffStatus @default(OFF_DUTY) @map("current_status")

  hireDate        DateTime  @map("hire_date") @db.Date
  terminationDate DateTime? @map("termination_date") @db.Date

  active Boolean @default(true)

  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id])

  roleAssignments StaffAssignment[]
  shifts          ShiftSchedule[]
  activities      StaffActivity[]
  clockInRecords  StaffClockIn[]

  @@unique([userId, organizationId])
  @@index([organizationId, active])
  @@index([employeeId])
  @@index([currentStatus])
  @@map("organization_staff")
}

model Organization {
  id        String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  orgType   OrganizationType @map("org_type")
  orgCode   String           @unique @map("org_code") @db.VarChar(20)
  name      String           @db.VarChar(255)
  legalName String           @map("legal_name") @db.VarChar(255)

  // FHIR Identifier
  fhirId String? @unique @map("fhir_id") @db.VarChar(100)

  licenseNumber String  @unique @map("license_number") @db.VarChar(100)
  taxId         String? @map("tax_id") @db.VarChar(50)
  npiNumber     String? @unique @map("npi_number") @db.VarChar(20)

  address       Json
  contactInfo   Json  @map("contact_info")
  accreditation Json?

  // FHIR/HL7 Endpoints
  fhirEndpoint String? @map("fhir_endpoint")
