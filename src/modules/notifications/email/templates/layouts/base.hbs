<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{{subject}}</title>
    <style>
      body {
        margin: 0;
        padding: 0;
        background: #f4f7fb;
        color: #142033;
        font-family: "Segoe UI", Arial, sans-serif;
      }
      .shell {
        max-width: 640px;
        margin: 0 auto;
        padding: 32px 20px;
      }
      .card {
        background: #ffffff;
        border: 1px solid #d6e0ec;
        border-radius: 14px;
        padding: 32px;
      }
      .brand {
        font-size: 22px;
        font-weight: 700;
        margin-bottom: 24px;
        color: #0b5fff;
      }
      .footer {
        margin-top: 18px;
        font-size: 12px;
        color: #6c7a90;
      }
    </style>
  </head>
  <body>
    <div class="shell">
      <div class="card">
        <div class="brand">HealthSync Pro</div>
        {{{body}}}
      </div>
      <div class="footer">
        This email was sent by HealthSync Pro.
      </div>
    </div>
  </body>
</html>
